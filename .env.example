# Copy this file to .env and fill in values for your environment.
# The defaults below match the docker-compose.yml configuration.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/jobqueue?sslmode=disable
API_ADDR=0.0.0.0:8080
WORKER_ID=worker-local
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL=250ms
WORKER_LEASE_DURATION=30s
WORKER_HEARTBEAT_INTERVAL=10s
WORKER_RECOVERY_INTERVAL=5s
SHUTDOWN_TIMEOUT=25s

# Optional; raises GitHub API limits for dependency_audit jobs.
GITHUB_TOKEN=
